# ─────────────────────────────────────────────────────────────────────────────
# UniOne Backend — Environment Variables Template
#
# HOW TO USE:
#   1. Copy this file:   copy .env.example .env
#   2. Fill in your real MySQL credentials in the new .env file.
#   3. Never commit the .env file — it is listed in .gitignore.
#
# START THE SERVER:
#   node --env-file=.env server.js
#   (or: npm start)
# ─────────────────────────────────────────────────────────────────────────────

# Express server port
PORT=5000

# MySQL connection details
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=unione_db
